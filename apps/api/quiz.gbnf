root ::= q1 q2 q3 q4? q5?

q1 ::= "Q1: " question-text "?" ws answers ws
q2 ::= "Q2: " question-text "?" ws answers ws
q3 ::= "Q3: " question-text "?" ws answers ws
q4 ::= "Q4: " question-text "?" ws answers ws
q5 ::= "Q5: " question-text "?" ws answers ws

answers ::= correct-a | correct-b | correct-c | correct-d

correct-a ::= "A) " answer-text " [CORRECT]" ws "B) " answer-text ws "C) " answer-text ws "D) " answer-text ws
correct-b ::= "A) " answer-text ws "B) " answer-text " [CORRECT]" ws "C) " answer-text ws "D) " answer-text ws
correct-c ::= "A) " answer-text ws "B) " answer-text ws "C) " answer-text " [CORRECT]" ws "D) " answer-text ws
correct-d ::= "A) " answer-text ws "B) " answer-text ws "C) " answer-text ws "D) " answer-text " [CORRECT]" ws

question-text ::= [a-zA-Z0-9 ,.'"-]+
answer-text ::= [a-zA-Z0-9 ,.'"-]+
ws ::= "\n"
